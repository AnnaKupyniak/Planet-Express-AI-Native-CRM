# Groq API Key (отримай безкоштовно на https://console.groq.com)
OPENAI_API_KEY=gsk_your_groq_api_key_here

# Перенаправлення запитів з OpenAI SDK на швидкі сервери Groq
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# URL вашого Node.js Express API
EXPRESS_API_URL=http://localhost:4000/api

# Обмеження кількості кроків для забігання нескінченних циклів
MAX_AGENT_STEPS=12

# Авторизація агента в CRM
AGENT_EMAIL=agent@planetexpress.com
AGENT_PASSWORD=admin123